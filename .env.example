POSTGRES_USER=event_sharing
POSTGRES_PASSWORD=replace-with-a-unique-password
PGADMIN_EMAIL=pgadmin@denora.nl
PGADMIN_PASSWORD=replace-with-a-unique-password
PGADMIN_PORT=5050
# Set a unique backup passphrase in .env, and keep a copy outside the server.
BACKUP_PASSPHRASE=
BACKUP_RETENTION_DAYS=30
PROJECT_BACKUP_PATH=/storage/event-sharing-backups
GATEWAY_PORT=8000
FRONTEND_PORT=3001
# Public site address, used by the frontend, Gateway, and Auth.
FRONTEND_ORIGIN=https://events.denora.nl
NETWORK_PREFIX=10.77
# pnpm env:services adds a database password for each service.
