{
  "name": "event-sharing",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r --if-present build",
    "typecheck": "pnpm build && pnpm -r --if-present typecheck && tsc -p scripts/tsconfig.json --noEmit",
    "dev:frontend": "pnpm --filter @event-sharing/contracts build && pnpm --filter @event-sharing/frontend dev",
    "start:frontend": "pnpm --filter @event-sharing/contracts build && pnpm --filter @event-sharing/frontend start",
    "env:services": "tsx scripts/setup-service-envs.ts",
    "server:status": "docker compose ps",
    "docker:up": "docker compose --profile tools --profile backup up -d --build",
    "docker:stop": "docker compose --profile tools --profile backup stop",
    "research": "tsx research/run.ts",
    "research:test": "tsx --test research/tests/*.test.ts",
    "research:charts": "docker run --rm --user $(id -u) -e HOME=/tmp -v \"$PWD/research:/research\" python:3.13-slim sh -c 'pip install -q --no-warn-script-location -r /research/analysis/requirements.txt && python /research/analysis/charts.py'"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "dotenv": "^17.4.2",
    "prettier": "^3.9.6",
    "rimraf": "^6.1.3",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2"
  }
}
