{
  "name": "event-sharing",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r --if-present build",
    "typecheck": "pnpm build && pnpm -r --if-present typecheck && tsc -p scripts/tsconfig.json --noEmit",
    "test:integration": "tsx scripts/integration/invitation-flow.ts",
    "dev:backend": "pnpm build && pnpm --parallel --filter \"./services/**\" --filter \"./apps/gateway\" dev",
    "start:backend": "pnpm build && pnpm --parallel --filter \"./services/**\" --filter \"./apps/gateway\" start",
    "dev:core": "pnpm build && pnpm --parallel --filter @event-sharing/auth --filter @event-sharing/gateway --filter @event-sharing/users --filter @event-sharing/events --filter @event-sharing/geo-search --filter @event-sharing/participation --filter @event-sharing/notifications --filter @event-sharing/messages --filter @event-sharing/event-log dev",
    "start:core": "pnpm build && pnpm --parallel --filter @event-sharing/auth --filter @event-sharing/gateway --filter @event-sharing/users --filter @event-sharing/events --filter @event-sharing/geo-search --filter @event-sharing/participation --filter @event-sharing/notifications --filter @event-sharing/messages --filter @event-sharing/event-log start",
    "dev:frontend": "pnpm --filter @event-sharing/contracts build && pnpm --filter @event-sharing/frontend dev",
    "start:frontend": "pnpm --filter @event-sharing/contracts build && pnpm --filter @event-sharing/frontend start",
    "env:services": "tsx scripts/setup-service-envs.ts",
    "kafka:topics": "tsx scripts/create-kafka-topics.ts",
    "server:status": "docker compose ps",
    "infra:up": "docker compose up -d postgres kafka",
    "infra:stop": "docker compose --profile tools stop"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "dotenv": "^17.4.2",
    "prettier": "^3.9.6",
    "rimraf": "^6.1.3",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2"
  }
}
