{
  "name": "event-sharing",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r --if-present build",
    "typecheck": "pnpm build && pnpm -r --if-present typecheck && tsc -p scripts/tsconfig.json --noEmit",
    "dev:frontend": "pnpm --filter @event-sharing/contracts build && pnpm --filter @event-sharing/frontend dev",
    "start:frontend": "pnpm --filter @event-sharing/contracts build && pnpm --filter @event-sharing/frontend start",
    "env:services": "tsx scripts/setup-service-envs.ts",
    "server:status": "docker compose ps",
    "docker:up": "docker compose --profile tools --profile backup up -d --build --remove-orphans",
    "docker:stop": "docker compose --profile tools --profile backup stop",
    "docker:dev": "docker compose -f docker-compose.yml -f docker-compose.dev.yml up -d",
    "docker:dev:build": "docker compose -f docker-compose.yml -f docker-compose.dev.yml up -d --build",
    "docker:dev:stop": "docker compose -f docker-compose.yml -f docker-compose.dev.yml stop"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "dotenv": "^17.4.2",
    "prettier": "^3.9.6",
    "rimraf": "^6.1.3",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2"
  }
}
