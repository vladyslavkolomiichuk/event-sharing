NODE_ENV=development
PORT=8002
DATABASE_URL=postgresql://event_sharing:replace-with-a-unique-password@127.0.0.1:5434/auth_db
HOST=127.0.0.1
BETTER_AUTH_SECRET=replace-with-a-random-secret-of-at-least-32-characters
BETTER_AUTH_URL=http://127.0.0.1:8000
BETTER_AUTH_PUBLIC_URL=http://127.0.0.1:3001/backend/auth
FRONTEND_ORIGIN=http://127.0.0.1:3001
EVENTS_SERVICE_URL=http://127.0.0.1:8001
# GOOGLE_CLIENT_ID=your-google-client-id
# GOOGLE_CLIENT_SECRET=your-google-client-secret
# GITHUB_CLIENT_ID=your-github-client-id
# GITHUB_CLIENT_SECRET=your-github-client-secret
AUTH_JWT_AUDIENCE=event-sharing-services
MAIL_ENCRYPTION_KEY=replace-with-the-same-64-character-hex-key-as-notifications
MAIL_DELIVERY_ENABLED=false
# Set KAFKA_BROKERS when the project broker is available.
