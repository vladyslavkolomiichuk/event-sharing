generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum EventStatus {
  DRAFT
  MODERATION
  REJECTED
  APPROVED
  PUBLISHED
  REGISTRATION_OPEN
  REGISTRATION_CLOSED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  ARCHIVED
}

enum LocationVisibility {
  PUBLIC
  PARTICIPANTS_ONLY
}

model Category {
  id        String   @id @default(uuid()) @db.Uuid
  name      String   @unique
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  events    Event[]

  @@map("category")
}

model Event {
  id                        String             @id @default(uuid()) @db.Uuid
  organizerId               String             @db.Uuid
  categoryId                String?            @db.Uuid
  category                  Category?          @relation(fields: [categoryId], references: [id])
  title                     String
  description               String
  startTime                 DateTime           @db.Timestamptz(3)
  endTime                   DateTime           @db.Timestamptz(3)
  status                    EventStatus        @default(DRAFT)
  moderationReason          String?
  cancellationReason        String?
  locationAddress           String
  locationRegion            String?
  latitude                  Decimal            @db.Decimal(9, 6)
  longitude                 Decimal            @db.Decimal(9, 6)
  locationVisibility        LocationVisibility @default(PARTICIPANTS_ONLY)
  participantLimit          Int
  chatEnabled               Boolean            @default(false)
  version                   Int                @default(1)
  lastSnapshotEventId       String?            @db.Uuid
  policyVersion             Int                @default(0)
  pendingPolicyVersion      Int?
  pendingStatus             EventStatus?
  pendingParticipantLimit   Int?
  pendingCancellationReason String?
  policyError               String?
  createdAt                 DateTime           @default(now()) @db.Timestamptz(3)
  updatedAt                 DateTime           @updatedAt @db.Timestamptz(3)

  participantAccess ParticipantAccess[]

  @@index([organizerId, id])
  @@index([status, id])
  @@index([createdAt, id])
  @@index([organizerId, createdAt, id])
  @@index([categoryId, createdAt, id])
  @@map("event")
}

model ParticipantAccess {
  eventId   String   @db.Uuid
  userId    String   @db.Uuid
  active    Boolean  @default(true)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
  event     Event    @relation(fields: [eventId], references: [id])

  @@id([eventId, userId])
  @@map("participant_access")
}

model InboxEvent {
  id          String   @id @db.Uuid
  eventType   String
  processedAt DateTime @default(now()) @db.Timestamptz(3)

  @@map("inbox_event")
}

model OutboxEvent {
  id          String    @id @default(uuid()) @db.Uuid
  position    BigInt    @unique @default(autoincrement())
  aggregateId String    @db.Uuid
  eventType   String
  payload     Json
  occurredAt  DateTime  @default(now()) @db.Timestamptz(3)
  publishedAt DateTime? @db.Timestamptz(3)
  attempts    Int       @default(0)

  @@index([publishedAt, occurredAt])
  @@map("outbox_event")
}
