NODE_ENV=development
PORT=8004
DATABASE_URL=postgresql://event_sharing:replace-with-a-unique-password@127.0.0.1:5434/geo_search_db
HOST=127.0.0.1
AUTH_JWT_ISSUER=http://127.0.0.1:8000
AUTH_JWT_AUDIENCE=event-sharing-services
KAFKA_BROKERS=127.0.0.1:9092
VALHALLA_URL=https://valhalla1.openstreetmap.de
# For global Transitland routing, set VALHALLA_URL to https://transit.land/api/v2/routing/valhalla
# and set VALHALLA_API_KEY in this service's .env.
VALHALLA_CLIENT_ID=event-sharing-development

# Run pnpm exec tsx scripts/setup-service-bus.ts from the repository root.
SERVICE_BUS_KEYS='{}'
PRIVACY_SERVICE_KEY=replace-with-the-generated-service-privacy-key
