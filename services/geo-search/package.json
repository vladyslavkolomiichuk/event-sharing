{
  "name": "@event-sharing/geo-search",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "clean": "rimraf dist",
    "build": "pnpm run clean && pnpm prisma:generate && tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "prisma:generate": "prisma generate",
    "db:migrate:deploy": "prisma migrate deploy"
  },
  "dependencies": {
    "@event-sharing/common": "workspace:*",
    "@event-sharing/contracts": "workspace:*",
    "@event-sharing/messaging": "workspace:*",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "express": "^5.2.1",
    "jose": "^6.2.13",
    "kafkajs": "^2.2.4",
    "pg": "^8.23.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/pg": "^8.23.1",
    "prisma": "7.10.0",
    "tsx": "^4.23.13"
  }
}
