generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model InboxEvent {
  id          String   @id @db.Uuid
  eventType   String
  processedAt DateTime @default(now()) @db.Timestamptz(3)

  @@map("inbox_event")
}

model OutboxEvent {
  id          String    @id @default(uuid()) @db.Uuid
  aggregateId String    @db.Uuid
  eventType   String
  payload     Json
  occurredAt  DateTime  @default(now()) @db.Timestamptz(3)
  publishedAt DateTime? @db.Timestamptz(3)
  attempts    Int       @default(0)

  @@index([publishedAt, occurredAt])
  @@map("outbox_event")
}

model PendingSnapshotEvent {
  id              String   @id @db.Uuid
  previousEventId String   @db.Uuid
  envelope        String
  receivedAt      DateTime @default(now()) @db.Timestamptz(3)

  @@index([previousEventId])
  @@map("pending_snapshot_event")
}

model EventProjection {
  id          String  @id @db.Uuid
  organizerId String  @db.Uuid
  title       String
  status      String
  chatEnabled Boolean @default(false)
  version     Int

  @@map("event_projection")
}

model MembershipProjection {
  eventId  String   @db.Uuid
  userId   String   @db.Uuid
  active   Boolean
  lastMembershipEventId String? @db.Uuid
  joinedAt DateTime @default(now()) @db.Timestamptz(3)

  @@id([eventId, userId])
  @@map("membership_projection")
}

model PendingMembershipEvent {
  id         String   @id @db.Uuid
  previousEventId String @db.Uuid
  envelope   String
  receivedAt DateTime @default(now()) @db.Timestamptz(3)

  @@index([previousEventId])
  @@map("pending_membership_event")
}

model UserProjection {
  id   String @id @db.Uuid
  name String

  @@map("user_projection")
}

model ChatRoom {
  id         String          @id @default(uuid()) @db.Uuid
  eventId    String          @db.Uuid
  name       String
  access     String          @default("ALL_PARTICIPANTS")
  status     String          @default("ACTIVE")
  createdBy  String          @db.Uuid
  createdAt  DateTime        @default(now()) @db.Timestamptz(3)
  archivedAt DateTime?       @db.Timestamptz(3)
  messages   ChatMessage[]
  reads      ChatReadState[]
  members    ChatRoomMember[]

  @@unique([eventId, name])
  @@index([eventId, createdAt])
  @@map("chat_room")
}

model ChatRoomMember {
  roomId    String    @db.Uuid
  userId    String    @db.Uuid
  status    String    @default("PENDING")
  joinedAt  DateTime? @db.Timestamptz(3)
  removedAt DateTime? @db.Timestamptz(3)
  room      ChatRoom  @relation(fields: [roomId], references: [id])

  @@id([roomId, userId])
  @@index([userId, status])
  @@map("chat_room_member")
}

model ChatReadState {
  roomId            String   @db.Uuid
  userId            String   @db.Uuid
  lastReadAt        DateTime @db.Timestamptz(3)
  lastReadMessageId String   @db.Uuid
  room              ChatRoom @relation(fields: [roomId], references: [id])

  @@id([roomId, userId])
  @@map("chat_read_state")
}

model ChatMessage {
  id        String   @id @default(uuid()) @db.Uuid
  roomId    String   @db.Uuid
  eventId   String   @db.Uuid
  senderId  String   @db.Uuid
  clientMessageId String @db.Uuid
  body      String
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  room      ChatRoom @relation(fields: [roomId], references: [id])

  @@index([roomId, createdAt, id])
  @@index([senderId, createdAt])
  @@unique([senderId, clientMessageId])
  @@map("chat_message")
}
