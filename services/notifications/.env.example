NODE_ENV=development
PORT=8006
DATABASE_URL=postgresql://event_sharing:replace-with-a-unique-password@127.0.0.1:5434/notifications_db
HOST=127.0.0.1
KAFKA_BROKERS=127.0.0.1:9092
AUTH_JWKS_URL=http://127.0.0.1:8002/auth/jwks
