generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum RegistrationStatus {
  OPEN
  CLOSED
  CANCELLED
}

enum MembershipStatus {
  JOINED
  LEFT
  CANCELLED
}

model RegistrationPolicy {
  eventId       String             @id @db.Uuid
  organizerId   String             @db.Uuid
  version       Int
  status        RegistrationStatus
  capacity      Int
  endTime       DateTime?          @db.Timestamptz(3)
  visibility    String             @default("PUBLIC")
  title         String             @default("Event")
  occupied      Int                @default(0)
  updatedAt     DateTime           @updatedAt @db.Timestamptz(3)

  memberships Membership[]

  @@map("registration_policy")
}

model InviteLink {
  id          String    @id @default(uuid()) @db.Uuid
  eventId     String    @db.Uuid
  tokenHash   String    @unique
  createdBy   String    @db.Uuid
  expiresAt   DateTime  @db.Timestamptz(3)
  maxUses     Int?
  uses        Int       @default(0)
  revokedAt   DateTime? @db.Timestamptz(3)
  createdAt   DateTime  @default(now()) @db.Timestamptz(3)

  @@index([eventId, createdAt])
  @@map("invite_link")
}

model PersonalInvite {
  id          String   @id @default(uuid()) @db.Uuid
  eventId     String   @db.Uuid
  recipientId String   @db.Uuid
  senderId    String   @db.Uuid
  title       String
  status      String   @default("PENDING")
  notifiedAt  DateTime? @db.Timestamptz(3)
  expiresAt   DateTime @db.Timestamptz(3)
  createdAt   DateTime @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @db.Timestamptz(3)

  @@unique([eventId, recipientId])
  @@index([recipientId, status, createdAt])
  @@index([eventId, createdAt])
  @@map("personal_invite")
}

model Membership {
  eventId  String           @db.Uuid
  userId   String           @db.Uuid
  status   MembershipStatus @default(JOINED)
  joinedAt DateTime         @default(now()) @db.Timestamptz(3)
  leftAt   DateTime?        @db.Timestamptz(3)

  policy RegistrationPolicy @relation(fields: [eventId], references: [eventId])

  @@id([eventId, userId])
  @@index([userId, status])
  @@map("membership")
}

model InboxEvent {
  id          String   @id @db.Uuid
  eventType   String
  processedAt DateTime @default(now()) @db.Timestamptz(3)

  @@map("inbox_event")
}

model PendingPolicyEvent {
  id            String   @id @db.Uuid
  aggregateId   String   @db.Uuid
  policyVersion Int
  payload       Json
  receivedAt    DateTime @default(now()) @db.Timestamptz(3)

  @@unique([aggregateId, policyVersion])
  @@map("pending_policy_event")
}

model OutboxEvent {
  id          String    @id @default(uuid()) @db.Uuid
  position    BigInt    @unique @default(autoincrement())
  aggregateId String    @db.Uuid
  eventType   String
  payload     Json
  occurredAt  DateTime  @default(now()) @db.Timestamptz(3)
  publishedAt DateTime? @db.Timestamptz(3)
  attempts    Int       @default(0)

  @@index([publishedAt, occurredAt])
  @@map("outbox_event")
}
