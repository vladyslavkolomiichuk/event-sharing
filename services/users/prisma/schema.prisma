generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model UserProfile {
  userId   String @id @db.Uuid
  name     String @default("Member")
  username String

  avatarUrl  String?
  bio        String?
  phone      String?
  city       String?
  version    Int             @default(1)
  createdAt  DateTime        @default(now()) @db.Timestamptz(3)
  updatedAt  DateTime        @updatedAt @db.Timestamptz(3)
  preference UserPreference?

  @@unique([username])
  @@map("user_profile")
}

model UserPreference {
  userId                    String   @id @db.Uuid
  showPhone                 Boolean  @default(false)
  showCity                  Boolean  @default(true)
  notificationsEnabled      Boolean  @default(true)
  allowFriendRequests       Boolean  @default(true)
  allowInvitesFromStrangers Boolean  @default(true)
  profileVisibility         String   @default("PUBLIC")
  discoverableByUsername    Boolean  @default(true)
  showParticipationHistory  Boolean  @default(false)
  updatedAt                 DateTime @updatedAt @db.Timestamptz(3)

  profile UserProfile @relation(fields: [userId], references: [userId], onDelete: Cascade)

  @@map("user_preference")
}

model FriendRequest {
  id          String   @id @default(uuid()) @db.Uuid
  senderId    String   @db.Uuid
  recipientId String   @db.Uuid
  status      String   @default("PENDING")
  createdAt   DateTime @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @db.Timestamptz(3)

  @@unique([senderId, recipientId])
  @@index([recipientId, status, createdAt])
  @@index([senderId, status, createdAt])
  @@map("friend_request")
}

model Friendship {
  userIdA   String   @db.Uuid
  userIdB   String   @db.Uuid
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  @@id([userIdA, userIdB])
  @@index([userIdB])
  @@map("friendship")
}

model UserBlock {
  blockerId String   @db.Uuid
  blockedId String   @db.Uuid
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  @@id([blockerId, blockedId])
  @@index([blockedId])
  @@map("user_block")
}

model InboxEvent {
  id          String   @id @db.Uuid
  eventType   String
  processedAt DateTime @default(now()) @db.Timestamptz(3)

  @@map("inbox_event")
}

model OutboxEvent {
  id          String    @id @default(uuid()) @db.Uuid
  position    BigInt    @unique @default(autoincrement())
  aggregateId String    @db.Uuid
  eventType   String
  payload     Json
  occurredAt  DateTime  @default(now()) @db.Timestamptz(3)
  publishedAt DateTime? @db.Timestamptz(3)
  attempts    Int       @default(0)

  @@index([publishedAt, occurredAt])
  @@map("outbox_event")
}
