generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model UserProfile {
  userId    String   @id @db.Uuid
  name      String   @default("Member")
  avatarUrl String?
  bio       String?
  phone     String?
  city      String?
  version   Int      @default(1)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  @@map("user_profile")
}

model UserPreference {
  userId               String   @id @db.Uuid
  showPhone            Boolean  @default(false)
  showCity             Boolean  @default(true)
  notificationsEnabled Boolean  @default(true)
  updatedAt            DateTime @updatedAt @db.Timestamptz(3)

  @@map("user_preference")
}

model InboxEvent {
  id          String   @id @db.Uuid
  eventType   String
  processedAt DateTime @default(now()) @db.Timestamptz(3)

  @@map("inbox_event")
}

model OutboxEvent {
  id          String    @id @default(uuid()) @db.Uuid
  position    BigInt    @unique @default(autoincrement())
  aggregateId String    @db.Uuid
  eventType   String
  payload     Json
  occurredAt  DateTime  @default(now()) @db.Timestamptz(3)
  publishedAt DateTime? @db.Timestamptz(3)
  attempts    Int       @default(0)

  @@index([publishedAt, occurredAt])
  @@map("outbox_event")
}
